# LibraFlow Kubernetes Secret Template
# Copy this file to secret.yaml and adjust the base64-encoded secret value.
# To encode a secret in PowerShell:
# [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes("your-strong-production-key"))

apiVersion: v1
kind: Secret
metadata:
  name: libraflow-secret
  namespace: libraflow
type: Opaque
data:
  # Base64 string for "libraflow-k8s-cluster-secret-key-2026"
  SECRET_KEY: bGlicmFmbG93LWs4cy1jbHVzdGVyLXNlY3JldC1rZXktMjAyNg==
